# Editor defaults for the Rust/Godot project and Python tooling.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{rs,py}]
max_line_length = 100

[*.{gd,gdshader}]
indent_style = tab

[*.{yml,yaml,json,js}]
indent_size = 2
