{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Native: Godot with Rust extension (prepared assets)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/tools/godot-4.7.2/Godot.app/Contents/MacOS/Godot",
            "args": [
                "--path",
                "${workspaceFolder}/godot"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Native: build dev extension"
        }
    ]
}
