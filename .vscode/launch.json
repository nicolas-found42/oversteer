{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Native: Godot with Rust extension (prepared assets)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/tools/godot-4.7.2/Godot.app/Contents/MacOS/Godot",
            "args": [
                "--path",
                "${workspaceFolder}/godot"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Native: build dev extension"
        },
        {
            "name": "Legacy C: Debug headless tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tests/oversteer_tests.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "Legacy C: Build headless tests",
            "setupCommands": [
                {
                    "description": "pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Legacy C: Debug one scenario",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tests/oversteer_tests.exe",
            "args": [
                "--scenario",
                "${input:scenario}",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "Legacy C: Build headless tests"
        },
        {
            "name": "Legacy C: Debug the game (fresh launch)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dev/oversteer.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "Legacy C: Build hot-reload module"
        },
        {
            "name": "Legacy C: Attach to the running game",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/dev/oversteer.exe",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
        },
        {
            "name": "Legacy C: Debug a scene capture",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dev/oversteer.exe",
            "args": [
                "--capture-scene",
                "physics_lab",
                "--output",
                "artifacts/screenshots/physics_lab.png"
            ],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "Legacy C: Build hot-reload module"
        }
    ],
    "inputs": [
        {
            "id": "scenario",
            "type": "promptString",
            "description": "scenario name (oversteer_tests --list)",
            "default": "skidpad"
        }
    ]
}
