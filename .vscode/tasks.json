{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Native: check",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/dev.py",
                "check"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Native: test",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/dev.py",
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Native: lint",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/dev.py",
                "lint"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Native: format",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/dev.py",
                "format"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Native: doctor",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/dev.py",
                "doctor"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Native: build dev extension",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/build.py",
                "build",
                "--profile",
                "dev",
                "--skip-import"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Native: build release and import",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/build.py",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Legacy C: Build hot-reload module",
            "detail": "build.bat \u2014 rebuilds build/dev/game.dll (and build/dev/oversteer.exe when it is not running)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "Legacy C: Build headless tests",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": [
                "--tests"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Legacy C: Run headless tests",
            "detail": "every scenario, with telemetry",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\tests\\oversteer_tests.exe",
            "dependsOn": "Legacy C: Build headless tests",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "Legacy C: Run one scenario",
            "detail": "pick from the scenario list",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\tests\\oversteer_tests.exe",
            "args": [
                "--scenario",
                "${input:scenario}"
            ],
            "dependsOn": "Legacy C: Build headless tests",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Legacy C: Telemetry report for a scenario",
            "detail": "runs the scenario, then writes artifacts/report_<name>.html",
            "type": "shell",
            "command": "${workspaceFolder}\\mk.bat",
            "args": [
                "report",
                "NAME=${input:scenario}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Legacy C: Verify (fast)",
            "detail": "format check + unit and infrastructure scenarios",
            "type": "shell",
            "command": "${workspaceFolder}\\mk.bat",
            "args": [
                "verify-fast"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Legacy C: Verify (full local CI)",
            "detail": "static analysis, every scenario, and the regression comparison",
            "type": "shell",
            "command": "${workspaceFolder}\\mk.bat",
            "args": [
                "ci"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Legacy C: Capture screenshots",
            "detail": "deterministic scene captures into artifacts/screenshots",
            "type": "shell",
            "command": "${workspaceFolder}\\mk.bat",
            "args": [
                "screenshots"
            ],
            "problemMatcher": []
        },
        {
            "label": "Legacy C: Regenerate compile_commands.json",
            "detail": "clangd needs this to use the real build flags",
            "type": "shell",
            "command": "${workspaceFolder}\\mk.bat",
            "args": [
                "compile-commands"
            ],
            "problemMatcher": []
        },
        {
            "label": "Legacy C: Run the game (developer only)",
            "detail": "does not return until the window is closed",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\dev\\oversteer.exe",
            "dependsOn": "Legacy C: Build hot-reload module",
            "isBackground": true,
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "scenario",
            "type": "pickString",
            "description": "scenario name",
            "default": "skidpad",
            "options": [
                "math",
                "units",
                "timestep",
                "oneshot",
                "replay",
                "renderscale",
                "telemetry",
                "vehicle",
                "tire",
                "drivetrain",
                "rest",
                "launch-stop",
                "coast-down",
                "brake-corner",
                "power-oversteer",
                "handbrake",
                "low-speed",
                "reverse",
                "steer-sign",
                "lever-arm",
                "integration",
                "fixed-rate",
                "params",
                "devreplay",
                "skidpad",
                "step-steer",
                "transition",
                "lift-off"
            ]
        }
    ]
}
