{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Native: check",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/dev.py",
                "check"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Native: test",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/dev.py",
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Native: lint",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/dev.py",
                "lint"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Native: format",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/dev.py",
                "format"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Native: doctor",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/dev.py",
                "doctor"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Native: build dev extension",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/build.py",
                "build",
                "--profile",
                "dev",
                "--skip-import"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Native: build release and import",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "python",
                "tools/game/build.py",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        }
    ]
}
