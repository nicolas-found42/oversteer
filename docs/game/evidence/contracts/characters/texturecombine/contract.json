    "epsilon": 1.0000000116860974e-07,
    "selection": "Onlyif vRange.x < H AND H < vRange.y; both endpoints excluded; no circular/wrapped range interpretation",
    "modification": "H+=vValue.x;S*=vValue.y;V*=vValue.z",
    "debug_override": "If testHSV.x!=0,setH=testHSV.x,S=testHSV.y,V=testHSV.z",
    "grayscale": "IfH==-1 OR S==0,outputRGB=(V,V,V)",
    "hue_wrap": "Exactlytwo passes: ifH>=360 subtract360; ifH<0 add360. Notunboundedmodulo.",
    "conversion": [
      "q=H/60;i=trunc(q);f=q-i;p=V*(1-S);a=V*(1-S*f);b=V*(1-S*(1-f))",
      "i0:(V,b,p);i1:(a,V,p);i2:(p,V,b);i3:(p,a,V);i4:(b,p,V);otherwise:(V,p,a)"
    ],
    "alpha": "A.aunchanged",
