# Real UI purchase/offer followed by the existing scenario AI's normal race.
extends "ui_hud_navigation.gd"
func run():
    app = load("res://main.tscn").instantiate()
    root.add_child(app)
    for i in range(600):
        await process_frame
        if JSON.parse_string(app.diagnostic_snapshot()).snapshot.screen == "Race":
            break
    await visual_ready()
    await settle(20)
    await key(KEY_ESCAPE)
    var stake_before = JSON.parse_string(app.diagnostic_snapshot()).snapshot
    await press("restart")
    check(focus_action() == "confirm_no", "cash restart defaults to Cancel")
    await joy(JOY_BUTTON_B)
    check(JSON.parse_string(app.diagnostic_snapshot()).snapshot.career == stake_before.career, "cancelled cash restart preserves wallet and garage")
    await press("nav:main")
    check(focus_action() == "confirm_no", "cash exit defaults to Cancel")
    await capture("cash-forfeit-confirmation")
    await key(KEY_ESCAPE)
    check(JSON.parse_string(app.diagnostic_snapshot()).snapshot.screen == "Paused", "cash exit cancellation stays paused")
    await press("nav:main")
    await press("confirm_yes")
    check(JSON.parse_string(app.diagnostic_snapshot()).snapshot.career.cash == stake_before.career.cash, "cash exit does not deduct the already-held stake twice")
    await press("nav:career")
    await press("nav:dealer")
    await press("car:GT4_MINI0001")
    await press("buy")
    await press("confirm_yes")
    await press("nav:main")
    await press("nav:career")
    await press("nav:garage")
    await press("car:GT4_HOND0018")
    await press("nav:main")
    await press("nav:career")
    await press("career_events")
    if "loss" in output:
        await press("event:1")
    await press("start")
    await press("rival:3")
    check(button("offer_pink").disabled, "owned rival model cannot be offered for pink slips")
    var rival = "2"
    await press("rival:" + rival)
    await press("offer_pink")
    check(focus_action() == "confirm_no", "pink-slip Cancel initial focus")
    await capture("pink-confirmation")
    await key(KEY_ESCAPE)
    check(focus_action() == "offer_pink", "pink-slip cancellation restores offer focus")
    await press("offer_pink")
    await press("confirm_yes")
    await press("offer_accept")
    await capture("pink-accepted")
    await press("grid_launch")
    await visual_ready()
    await settle(20)
    await key(KEY_ESCAPE)
    var pink_before = JSON.parse_string(app.diagnostic_snapshot()).snapshot
    await press("restart")
    check(focus_action() == "confirm_no", "pink restart defaults to Cancel")
    await capture("pink-forfeit-confirmation")
    await press("confirm_no")
    await press("nav:main")
    check(focus_action() == "confirm_no", "pink exit defaults to Cancel")
    await key(KEY_ESCAPE)
    check(JSON.parse_string(app.diagnostic_snapshot()).snapshot.career == pink_before.career, "cancelled pink forfeit preserves ownership")
    await press("resume")
    var file = FileAccess.open(output + "/navigation.json", FileAccess.WRITE)
    file.store_string(JSON.stringify(evidence,"  "))
    # The existing career-race scenario captures Results and exits on completion.
